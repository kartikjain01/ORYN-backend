  "text_analysis": {
    "original_text": "\u0906\u091c \u0915\u0940 \u092d\u093e\u0917\u0926\u094c\u0921\u093c \u092d\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0915\u093e\u092e \u0915\u0947 \u0938\u093e\u0925-\u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u093e \u092d\u0940 \u092a\u0942\u0930\u093e \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0905\u0915\u094d\u0938\u0930 \u0939\u092e \u0915\u093e\u092e \u0915\u0947 \u0926\u092c\u093e\u0935 \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u0935\u094d\u092f\u0938\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u0939\u0940 \u0938\u092e\u092f \u092a\u0930 \u0916\u093e\u0928\u093e \u0916\u093e\u0928\u093e \u0914\u0930 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0928\u0940\u0902\u0926 \u0932\u0947\u0928\u093e \u0939\u0940 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0939\u092e \u0930\u094b\u091c\u093c \u0938\u0941\u092c\u0939 \u091c\u0932\u094d\u0926\u0940 \u0909\u0920\u0915\u0930 \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u0936\u093e\u0902\u0924 \u092e\u0928 \u0938\u0947 \u092c\u0948\u0920\u0947\u0902 \u092f\u093e \u0916\u0941\u0932\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u091f\u0939\u0932\u0947\u0902, \u0924\u094b \u0939\u092e\u093e\u0930\u093e \u092a\u0942\u0930\u093e \u0926\u093f\u0928 \u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u090a\u0930\u094d\u091c\u093e \u0938\u0947 \u092d\u0930\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u0938\u092e\u092f \u0915\u093e \u0938\u0939\u0940 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0939\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0905\u0938\u0932\u0940 \u0915\u0941\u0902\u091c\u0940 \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u092e\u092f \u0915\u0940 \u0915\u0926\u094d\u0930 \u0915\u0930\u0928\u093e \u0938\u0940\u0916 \u091c\u093e\u0924\u093e \u0939\u0948, \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092d\u0940 \u0915\u093e\u092e \u0905\u0938\u0902\u092d\u0935 \u0928\u0939\u0940\u0902 \u0930\u0939\u0924\u093e\u0964 \u0939\u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0928\u0940 \u091a\u093e\u0939\u093f\u090f \u0915\u093f \u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0940 \u0915\u0941\u091b \u092a\u0932 \u0916\u0941\u0936\u0940 \u0915\u0947 \u092c\u093f\u0924\u093e\u090f\u0902 \u0924\u093e\u0915\u093f \u092e\u093e\u0928\u0938\u093f\u0915 \u0924\u0928\u093e\u0935 \u0926\u0942\u0930 \u0930\u0939\u0947\u0964 \u091a\u0932\u093f\u090f \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u0940 \u0906\u0935\u093e\u091c \u0915\u093e \u092f\u0939 \u092e\u0949\u0921\u0932 \u0907\u0938 \u0938\u0940\u0927\u0947 \u0914\u0930 \u0938\u0930\u0932 \u0939\u093f\u0902\u0926\u0940 \u0938\u0902\u0926\u0947\u0936 \u0915\u094b \u0915\u093f\u0924\u0928\u0947 \u0938\u0941\u0902\u0926\u0930 \u0914\u0930 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "cleaned_text": "\u0906\u091c \u0915\u0940 \u092d\u093e\u0917\u0926\u094c\u0921\u093c \u092d\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0915\u093e\u092e \u0915\u0947 \u0938\u093e\u0925\u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u093e \u092d\u0940 \u092a\u0942\u0930\u093e \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0905\u0915\u094d\u0938\u0930 \u0939\u092e \u0915\u093e\u092e \u0915\u0947 \u0926\u092c\u093e\u0935 \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u0935\u094d\u092f\u0938\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u0939\u0940 \u0938\u092e\u092f \u092a\u0930 \u0916\u093e\u0928\u093e \u0916\u093e\u0928\u093e \u0914\u0930 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0928\u0940\u0902\u0926 \u0932\u0947\u0928\u093e \u0939\u0940 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0939\u092e \u0930\u094b\u091c\u093c \u0938\u0941\u092c\u0939 \u091c\u0932\u094d\u0926\u0940 \u0909\u0920\u0915\u0930 \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u0936\u093e\u0902\u0924 \u092e\u0928 \u0938\u0947 \u092c\u0948\u0920\u0947\u0902 \u092f\u093e \u0916\u0941\u0932\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u091f\u0939\u0932\u0947\u0902, \u0924\u094b \u0939\u092e\u093e\u0930\u093e \u092a\u0942\u0930\u093e \u0926\u093f\u0928 \u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u090a\u0930\u094d\u091c\u093e \u0938\u0947 \u092d\u0930\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u0938\u092e\u092f \u0915\u093e \u0938\u0939\u0940 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0939\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0905\u0938\u0932\u0940 \u0915\u0941\u0902\u091c\u0940 \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u092e\u092f \u0915\u0940 \u0915\u0926\u094d\u0930 \u0915\u0930\u0928\u093e \u0938\u0940\u0916 \u091c\u093e\u0924\u093e \u0939\u0948, \u0909\u0938\u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092d\u0940 \u0915\u093e\u092e \u0905\u0938\u0902\u092d\u0935 \u0928\u0939\u0940\u0902 \u0930\u0939\u0924\u093e\u0964 \u0939\u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0928\u0940 \u091a\u093e\u0939\u093f\u090f \u0915\u093f \u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0940 \u0915\u0941\u091b \u092a\u0932 \u0916\u0941\u0936\u0940 \u0915\u0947 \u092c\u093f\u0924\u093e\u090f\u0902 \u0924\u093e\u0915\u093f \u092e\u093e\u0928\u0938\u093f\u0915 \u0924\u0928\u093e\u0935 \u0926\u0942\u0930 \u0930\u0939\u0947\u0964 \u091a\u0932\u093f\u090f \u0926\u0947\u0916\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0939\u092e\u093e\u0930\u0940 \u0906\u0935\u093e\u091c \u0915\u093e \u092f\u0939 \u092e\u0949\u0921\u0932 \u0907\u0938 \u0938\u0940\u0927\u0947 \u0914\u0930 \u0938\u0930\u0932 \u0939\u093f\u0902\u0926\u0940 \u0938\u0902\u0926\u0947\u0936 \u0915\u094b \u0915\u093f\u0924\u0928\u0947 \u0938\u0941\u0902\u0926\u0930 \u0914\u0930 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",
    "enhanced_text": "\u0906\u091c \u0915\u0940 \u092d\u093e\u0917\u0926\u094c\u0921\u093c \u092d\u0930\u0940 \u091c\u093f\u0902\u0926\u0917\u0940 \u092e\u0947\u0902 \u0939\u092e\u0947\u0902 \u0905\u092a\u0928\u0947 \u0915\u093e\u092e \u0915\u0947 \u0938\u093e\u0925\u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0915\u093e \u092d\u0940 \u092a\u0942\u0930\u093e \u0927\u094d\u092f\u093e\u0928 \u0930\u0916\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964 \u0905\u0915\u094d\u0938\u0930 \u0939\u092e \u0915\u093e\u092e \u0915\u0947 \u0926\u092c\u093e\u0935 \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u0935\u094d\u092f\u0938\u094d\u0924 \u0939\u094b \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0938\u0939\u0940 \u0938\u092e\u092f \u092a\u0930 \u0916\u093e\u0928\u093e \u0916\u093e\u0928\u093e \u0914\u0930 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0928\u0940\u0902\u0926 \u0932\u0947\u0928\u093e \u0939\u0940 \u092d\u0942\u0932 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0939\u092e \u0930\u094b\u091c\u093c \u0938\u0941\u092c\u0939 \u091c\u0932\u094d\u0926\u0940 \u0909\u0920\u0915\u0930 \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u0936\u093e\u0902\u0924 \u092e\u0928 \u0938\u0947 \u092c\u0948\u0920\u0947\u0902 \u092f\u093e \u0916\u0941\u0932\u0940 \u0939\u0935\u093e \u092e\u0947\u0902 \u091f\u0939\u0932\u0947\u0902, \u0924\u094b \u0939\u092e\u093e\u0930\u093e \u092a\u0942\u0930\u093e \u0926\u093f\u0928 \u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915 \u090a\u0930\u094d\u091c\u093e \u0938\u0947 \u092d\u0930\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u0938\u092e\u092f \u0915\u093e \u0938\u0939\u0940 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0939\u0940 \u0938\u092b\u0932\u0924\u093e \u0915\u0940 \u0905\u0938\u0932\u0940 \u0915\u0941\u0902\u091c\u0940 \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u091c\u094b \u0935\u094d\u092f\u0915\u094d\u0924\u0