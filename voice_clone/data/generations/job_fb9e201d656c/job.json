      "\u0935\u0947 \u092a\u093e\u0928\u0940 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0906\u090f \u0914\u0930 \u092a\u0942\u091b\u093e, \u092a\u0941\u0924\u094d\u0930, \u0915\u094d\u092f\u093e \u0939\u0941\u0906?",
      "\u0924\u0941\u092e \u0915\u094d\u092f\u094b\u0902 \u0930\u094b \u0930\u0939\u0947 \u0939\u094b?\u0932\u0915\u0921\u093c\u0939\u093e\u0930\u0947 \u0928\u0947 \u0905\u092a\u0928\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u092c\u0924\u093e\u0908\u0964",
      "\u0926\u0947\u0935\u0924\u093e \u0928\u0947 \u0928\u0926\u0940 \u092e\u0947\u0902 \u0921\u0941\u092c\u0915\u0940 \u0932\u0917\u093e\u0908 \u0914\u0930 \u090f\u0915 \u0938\u094b\u0928\u0947 \u0915\u0940 \u0915\u0941\u0932\u094d\u0939\u093e\u0921\u093c\u0940 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u093e\u0932\u0915\u0930 \u092a\u0942\u091b\u093e, \u0915\u094d\u092f\u093e \u092f\u0939 \u0924\u0941\u092e\u094d\u0939\u093e\u0930\u0940 \u0915\u0941\u0932\u094d\u0939\u093e\u0921\u093c\u0940 \u0939\u0948?\u0932\u0915\u0921\u093c\u0939\u093e\u0930\u0947 \u0928\u0947 \u092e\u0928\u093e \u0915\u0930 \u0926\u093f\u092f\u093e \u0914\u0930 \u0915\u0939\u093e, \u092f\u0939 \u092e\u0947\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964\u0926\u0947\u0935\u0924\u093e \u0928\u0947 \u0926\u0942\u0938\u0930\u0940 \u092c\u093e\u0930 \u0921\u0941\u092c\u0915\u0940 \u0932\u0917\u093e\u0908 \u0914\u0930 \u090f\u0915 \u091a\u093e\u0901\u0926\u0940 \u0915\u0940 \u0915\u0941\u0932\u094d\u0939\u093e\u0921\u093c\u0940 \u0928\u093f\u0915\u093e\u0932\u0940\u0964",
      "\u0932\u0915\u0921\u093c\u0939\u093e\u0930\u0947 \u0928\u0947 \u092b\u093f\u0930 \u0915\u0939\u093e, \u092f\u0939 \u092d\u0940 \u092e\u0947\u0930\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
    ]
  },
  "language": "hi"
}